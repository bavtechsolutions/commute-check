# Copy to .env.local and fill in. Never commit .env.local or paste keys into chat.

# Met Office Weather DataHub -> Site Specific (Global Spot) subscription -> API key
METOFFICE_API_KEY=

# Rail Data Marketplace -> Live Departure Board product -> Specification tab
# Consumer Key (NOT the consumer secret)
RDM_LDB_API_KEY=
# Base URL exactly as shown on the Specification tab, up to and including the
# version segment, e.g. https://api1.raildata.org.uk/.../LDBWS/api/20220120
RDM_LDB_BASE_URL=
